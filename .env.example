# ── Base de datos (opcional) ──────────────────────────────────────────────────
# Si no está configurada, la API sigue funcionando con los CSV de data/ (fallback).
DATABASE_URL=

# ── Agente IA (opcional) ──────────────────────────────────────────────────────
# Sin esta clave, el agente autónomo (scripts/agente_monitor.py) y los endpoints
# /ia/* siguen funcionando: la detección de anomalías por reglas estadísticas no
# depende de Claude. Lo único que se pierde es la redacción en lenguaje natural
# (resumen ejecutivo, explicaciones por senador/partido/provincia) y el chat
# interactivo del dashboard (/ia/chat).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Límite de consultas diarias al chat del agente, por IP (protege el costo de
# la API de Anthropic en un endpoint público sin autenticación).
CHAT_RATE_LIMIT_DIARIO=30

# ── Notificaciones por mail (GitHub Actions) ──────────────────────────────────
# Usados por monitor_diario.yml y tests_diarios.yml — configurar como secrets
# del repositorio (Settings → Secrets and variables → Actions), no acá.
# MAIL_USER=
# MAIL_PASS=
